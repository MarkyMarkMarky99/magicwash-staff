# Portal workbook id, used by portal view sheet contracts.
PORTAL_SPREADSHEET_ID=
# OrderForm workbook id, used by the OrderForm sheet contract.
ORDERS_SPREADSHEET_ID=
# Appointments workbook id, used by the Appointments sheet contract.
APPOINTMENTS_SPREADSHEET_ID=
# Customers workbook id, used by the Customers sheet contract.
CUSTOMERS_SPREADSHEET_ID=
# Invoices and InvoiceItems workbook id, used by both sheet contracts.
INVOICES_SPREADSHEET_ID=
# Invoice view sync Apps Script URL, read by server/modules/invoices/invoice-view-sync-client.ts.
APPSCRIPT_INVOICE_VIEW_SYNC_URL=
# Base64-encoded JSON service-account key, read by server/shared/repositories/google-auth.ts.
GOOGLE_SERVICE_ACCOUNT_KEY=
