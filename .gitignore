# Local agent configuration. Skills travel with the repo; everything else here is
# machine-local. The directory is excluded as `.claude/*`, not `.claude/`, because git
# does not descend into an excluded directory — a negation inside one never matches.
.claude/*
!.claude/skills/

# Nested git worktrees (e.g. for sandboxed agent runs)
.worktrees/

# Local planning draft
/docs/invoice-create-plan.md

# Agent working notes — plans, handoffs, mocks
.agent-docs/

# Raw sheet data samples — contain real customer PII, never commit
/invoice-view-raw-sample.json
/invoice-view-parsed-sample.json


# Grok sandbox worktrees live here; each is its own checkout, never content of this one
.worktrees/
